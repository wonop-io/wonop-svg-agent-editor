{
  "id": "svg-editor",
  "apiVersion": 1,
  "name": "SVG Editor",
  "version": "0.3.0",
  "description": "Draw and edit SVG diagrams on a minimal canvas, with shared structured agent commands, safe preview and recoverable files.",
  "icon": "icon.svg",
  "entry": "main.ts",
  "ui": "ui/index.html",
  "window": {
    "width": 1100,
    "height": 760
  },
  "strictArgs": true,
  "commands": {
    "open": {
      "help": "Open a local SVG file; refuses to replace unsaved edits",
      "args": {
        "path": "string",
        "windowId": "string?"
      }
    },
    "state": {
      "help": "Current SVG source, saved source, unsaved state and recoverable drafts",
      "args": {
        "windowId": "string?"
      }
    },
    "edit": {
      "help": "Replace source against the exact expectedRevision; visual and agent edits share this revision.",
      "args": {
        "id": "string",
        "text": "string",
        "revision": "number",
        "windowId": "string?",
        "expectedRevision": "number"
      }
    },
    "save": {
      "help": "Save source; path chooses a new destination and refuses overwrite",
      "args": {
        "path": "string?",
        "windowId": "string?"
      }
    },
    "newDocument": {
      "help": "Start a simple architecture diagram; refuses unsaved edits",
      "args": {
        "windowId": "string?"
      }
    },
    "discard": {
      "help": "Explicitly discard edits and return to the last saved source",
      "args": {
        "windowId": "string?"
      }
    },
    "recover": {
      "help": "Recover a saved draft by its id",
      "args": {
        "id": "string",
        "windowId": "string?"
      }
    },
    "objects": {
      "help": "Read selectable diagram objects and viewBox with documentId/revision for structured edits. Keys are revision-scoped; read again after edits.",
      "args": {
        "windowId": "string?"
      }
    },
    "add": {
      "help": "Draw rect, ellipse, line or text in SVG coordinates; width/height are signed line deltas for lines.",
      "args": {
        "documentId": "string",
        "expectedRevision": "number",
        "windowId": "string?",
        "type": "string",
        "x": "number",
        "y": "number",
        "width": "number?",
        "height": "number?",
        "text": "string?",
        "fill": "string?",
        "stroke": "string?",
        "strokeWidth": "number?",
        "fontSize": "number?"
      }
    },
    "set": {
      "help": "Change one safe object property or its text label. Geometry/color/text are data; arbitrary SVG attributes are refused.",
      "args": {
        "documentId": "string",
        "expectedRevision": "number",
        "windowId": "string?",
        "key": "string",
        "property": "string",
        "value": "string"
      }
    },
    "move": {
      "help": "Move an object by dx/dy in its parent coordinate system.",
      "args": {
        "documentId": "string",
        "expectedRevision": "number",
        "windowId": "string?",
        "key": "string",
        "dx": "number",
        "dy": "number"
      }
    },
    "resize": {
      "help": "Set primitive geometry in its local coordinate system; boxes/ellipses/circles/lines only.",
      "args": {
        "documentId": "string",
        "expectedRevision": "number",
        "windowId": "string?",
        "key": "string",
        "x": "number",
        "y": "number",
        "width": "number",
        "height": "number"
      }
    },
    "remove": {
      "help": "Delete a selectable diagram object.",
      "args": {
        "documentId": "string",
        "expectedRevision": "number",
        "windowId": "string?",
        "key": "string"
      }
    },
    "undo": {
      "help": "Undo the most recent shared document edit.",
      "args": {
        "documentId": "string",
        "expectedRevision": "number",
        "windowId": "string?"
      }
    },
    "redo": {
      "help": "Redo the most recently undone shared document edit.",
      "args": {
        "documentId": "string",
        "expectedRevision": "number",
        "windowId": "string?"
      }
    }
  },
  "palette": [
    {
      "title": "Open an SVG diagram",
      "snippet": "await wm.apps[\"svg-editor\"].open({ path: {file} })",
      "args": [
        {
          "name": "file",
          "type": "path"
        }
      ]
    }
  ],
  "permissions": {
    "exec": [
      "head -c * * $",
      "mktemp * $",
      "tee * $",
      "mv -f * * $",
      "mv -n * * $",
      "rm -f * $"
    ]
  },
  "tabs": {
    "max": 8,
    "newTab": "blank",
    "label": "SVG"
  }
}
